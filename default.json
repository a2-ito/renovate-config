{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "a2-ito の全リポジトリで共有する基本ルール",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":timezone(Asia/Tokyo)",
    "group:allNonMajor"
  ],
  "schedule": ["* 0-8 * * 1"],
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security-dependency-update"]
  },
  "packageRules": [
    {
      "description": "Terraform の更新は plan の確認が要るので、minor / patch を他の依存と別の PR にまとめる",
      "matchCategories": ["terraform"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "terraform",
      "groupSlug": "terraform"
    },
    {
      "description": "eslint-plugin-react が ESLint 10 の新しいルール API に未対応で、lint 実行時にクラッシュする (Error while loading rule 'react/display-name')。上流が対応したら外す",
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    }
  ]
}
